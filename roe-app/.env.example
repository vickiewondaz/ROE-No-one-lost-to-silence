# Copy to .env.local (never commit). Pilot gate needs these before real data.
DATABASE_URL=postgresql://user:password@host:5432/roe
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# One-time pilot bootstrap (POST /api/setup). Remove after pilot.
ALLOW_SETUP=true
SETUP_SECRET=change-me-to-random-32-plus-chars
